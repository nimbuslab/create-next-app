# Database
# Valores locais, iguais aos do docker-compose.yml deste repositório.
# Em produção, troque pela connection string do seu provedor.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/app"

# Better Auth
# Gere um segredo real com: openssl rand -base64 32
BETTER_AUTH_SECRET="troque-por-um-segredo-gerado"
BETTER_AUTH_URL="http://localhost:3000"

# App
# URL pública usada pelo cliente de autenticação (src/lib/auth-client.ts)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
